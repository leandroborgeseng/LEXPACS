server {
    listen 80;
    server_name _;
    server_tokens off;

    # LP9 (parcial): log sem query string nem Referer (ver 00-lex-security.conf)
    access_log /var/log/nginx/access.log lex_sem_args;

    # DNS Docker — evita 502 após recreate de portal/viewer (IP antigo em cache)
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $lex_upstream_portal portal;
    set $lex_upstream_viewer web-viewer;
    # V1: Orthanc externo só por variável de ambiente (envsubst no start do nginx)
    set $lex_orthanc_url "${LEX_ORTHANC_URL}";
    set $lex_orthanc_auth "${LEX_ORTHANC_AUTH_HEADER}";

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security $lex_hsts_header always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob:; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;

    # Assets compartilhados (portal + login clínico)
    location /static/ {
        proxy_pass http://$lex_upstream_portal:8080$request_uri;
        proxy_set_header Host $host;
    }

    # ── Login clínico (público) ──
    location /clinica/ {
        proxy_pass http://$lex_upstream_portal:8080$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Portal do paciente (sem autenticação clínica) ──
    location /paciente/ {
        rewrite ^/paciente/?(.*)$ /$1 break;
        proxy_pass http://$lex_upstream_portal:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Portal do paciente: SÓ as rotas do paciente (allowlist). Qualquer outra /paciente-api/* => 404.
    location = /paciente-api/studies {
        rewrite ^/paciente-api/(.*)$ /api/$1 break;
        proxy_pass http://$lex_upstream_portal:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Authorization $http_authorization;
    }

    location ~ "^/paciente-api/studies/[0-9.]{1,64}/(?:report|report/pdf|viewer-session)$" {
        rewrite ^/paciente-api/(.*)$ /api/$1 break;
        proxy_pass http://$lex_upstream_portal:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Authorization $http_authorization;
    }

    location /paciente-api/ {
        return 404;
    }

    location = /paciente-api/auth/login {
        limit_req zone=lex_login burst=5 nodelay;
        rewrite ^/paciente-api/(.*)$ /api/$1 break;
        proxy_pass http://$lex_upstream_portal:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Login/logout clínico (público)
    location = /clinica-api/auth/clinical/login {
        limit_req zone=lex_login burst=5 nodelay;
        rewrite ^/clinica-api/(.*)$ /api/$1 break;
        proxy_pass http://$lex_upstream_portal:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /clinica-api/auth/clinical/logout {
        rewrite ^/clinica-api/(.*)$ /api/$1 break;
        proxy_pass http://$lex_upstream_portal:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Cookie $http_cookie;
    }

    location = /clinica-api/auth/clinical/config {
        rewrite ^/clinica-api/(.*)$ /api/$1 break;
        proxy_pass http://$lex_upstream_portal:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Sessão clínica → Bearer para DICOMweb (validação no portal, sem auth_request)
    location = /clinica-api/auth/clinical/session {
        rewrite ^/clinica-api/(.*)$ /api/$1 break;
        proxy_pass http://$lex_upstream_portal:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Cookie $http_cookie;
    }

    # Troca de senha obrigatória (U5): sessão validada no portal, mesmo com troca pendente
    location = /clinica-api/auth/clinical/change-password {
        limit_req zone=lex_login burst=5 nodelay;
        rewrite ^/clinica-api/(.*)$ /api/$1 break;
        proxy_pass http://$lex_upstream_portal:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Cookie $http_cookie;
    }

    location = /clinica-api/auth/clinical/me {
        rewrite ^/clinica-api/(.*)$ /api/$1 break;
        proxy_pass http://$lex_upstream_portal:8080;
        proxy_set_header Host $host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization $http_authorization;
    }

    # API clínica — sessão via cookie
    location /clinica-api/ {
        auth_request /internal/auth/clinical;
        error_page 401 = @clinica_login;

        rewrite ^/clinica-api/(.*)$ /api/$1 break;
        proxy_pass http://$lex_upstream_portal:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 120s;
        client_max_body_size 32M;
    }

    location @clinica_login {
        return 302 /clinica/login?next=$request_uri;
    }

    location = /internal/auth/clinical {
        internal;
        proxy_pass http://$lex_upstream_portal:8080/api/auth/validate-clinical;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization $http_authorization;
    }

    location = /paciente-api/auth/validate-viewer-cookie {
        return 404;
    }

    location = /paciente-api/auth/validate-clinical {
        return 404;
    }

    location = /paciente-api/auth/validate-dicom-access {
        return 404;
    }

    location = /internal/auth/viewer-cookie {
        internal;
        proxy_pass http://$lex_upstream_portal:8080/api/auth/validate-viewer-cookie;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Original-URI $request_uri;
    }

    location = /internal/auth/dicom-access {
        internal;
        proxy_pass http://$lex_upstream_portal:8080/api/auth/validate-dicom-access;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Original-URI $request_uri;
    }

    # ── DICOMweb / WADO ──
    location /dicom-web {
        # V2: somente leitura (QIDO/WADO). POST/PUT/DELETE (STOW etc.) => 403
        limit_except GET {
            deny all;
        }
        # V3: exige sessão clínica ou cookie de visualização do paciente
        auth_request /internal/auth/dicom-access;

        proxy_pass $lex_orthanc_url$request_uri;
        # Credenciais do Orthanc vêm do env do gateway; nunca as do navegador
        proxy_set_header Authorization $lex_orthanc_auth;
        proxy_set_header Cookie "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        client_max_body_size 1m;
        proxy_read_timeout 300s;
    }

    location /wado {
        # V2: somente leitura (QIDO/WADO). POST/PUT/DELETE (STOW etc.) => 403
        limit_except GET {
            deny all;
        }
        # V3: exige sessão clínica ou cookie de visualização do paciente
        auth_request /internal/auth/dicom-access;

        proxy_pass $lex_orthanc_url$request_uri;
        # Credenciais do Orthanc vêm do env do gateway; nunca as do navegador
        proxy_set_header Authorization $lex_orthanc_auth;
        proxy_set_header Cookie "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        client_max_body_size 1m;
        proxy_read_timeout 300s;
    }

    # ── Viewer OHIF ──
    # Chunks .js/.css etc. não podem exigir auth — lazy-load sem cookie devolve HTML (302)
    # e o React quebra (ex.: 9356.bundle.*.js → ErrorBoundary).
    location ~ ^/viewer/(.+\.(?:js|css|map|svg|png|jpe?g|gif|webp|ico|woff2?|ttf|eot|wasm|json|webmanifest|txt))$ {
        rewrite ^/viewer/?(.*)$ /$1 break;
        proxy_pass http://$lex_upstream_viewer:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /viewer/ {
        auth_request /internal/auth/dicom-access;
        error_page 401 = @clinica_login;

        rewrite ^/viewer/?(.*)$ /$1 break;
        proxy_pass http://$lex_upstream_viewer:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization $http_authorization;
    }

    location = /viewer {
        auth_request /internal/auth/dicom-access;
        error_page 401 = @clinica_login;

        proxy_pass http://$lex_upstream_viewer:80/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization $http_authorization;
    }

    location = / {
        return 302 /clinica/login;
    }

    location / {
        return 302 /clinica/login;
    }
}
